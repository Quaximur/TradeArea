.item-config-row {
    flex-direction: row;
    align-items: center;
    height: 72px;
    background-color: rgb(27, 33, 43);
    border-width: 1px;
    border-color: rgb(49, 58, 73);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-right: 4px;
    margin-left: 4px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.item-config-row:hover {
    background-color: rgb(34, 42, 55);
    border-color: rgb(80, 95, 115);
}

.item-config-row__icon {
    flex-shrink: 0;
    height: 100%;
    background-color: rgb(17, 21, 28);
    border-width: 1px;
    border-color: rgb(65, 76, 94);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    -unity-background-scale-mode: scale-to-fit;
    aspect-ratio: 1;
}

.item-config-row__name {
    flex-shrink: 0;
    min-width: 160px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(220, 230, 242);
    -unity-text-align: middle-left;
}

.item-config-row__start-container {
    margin-left: 10px;
    min-width: 300px;
}
