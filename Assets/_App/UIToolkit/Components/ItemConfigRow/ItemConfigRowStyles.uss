/* ── ItemConfigRow ───────────────────────────────────────────────────────────
   Base row used by OwnLotRow, LotRow, and any future list item rows.
   Palette is consistent with AuctionStyles.uss.
   ────────────────────────────────────────────────────────────────────────── */

.item-config-row {
    flex-direction: row;
    align-items: center;
    min-height: 58px;
    background-color: rgb(27, 33, 43);
    border-width: 1px;
    border-color: rgb(49, 58, 73);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
    margin-top: 2px;
    margin-bottom: 2px;
    /* Smooth hover transition */
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.item-config-row:hover {
    background-color: rgb(34, 42, 55);
    border-color: rgb(80, 95, 115);
}

/* ── Icon slot ───────────────────────────────────────────────────────────── */

.item-config-row__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background-color: rgb(17, 21, 28);
    border-width: 1px;
    border-color: rgb(65, 76, 94);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    /* Inner shadow feel — slightly lighter center for icon readability */
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Name label ──────────────────────────────────────────────────────────── */

.item-config-row__name {
    flex-shrink: 0;
    min-width: 160px;
    margin-left: 10px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(220, 230, 242);
    -unity-text-align: middle-left;
}
