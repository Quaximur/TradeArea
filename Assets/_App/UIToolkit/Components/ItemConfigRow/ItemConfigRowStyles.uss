.item-config-row {
    flex-direction: row;
    align-items: center;
    height: 72px;
    background-color: rgb(27, 33, 43);
    border-width: 1px;
    border-color: rgb(49, 58, 73);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-right: 4px;
    margin-left: 4px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.item-config-row:hover {
    background-color: rgb(34, 42, 55);
    border-color: rgb(80, 95, 115);
}

.item-config-row__icon {
    flex-shrink: 0;
    height: 100%;
    background-color: rgb(17, 21, 28);
    border-width: 1px;
    border-color: rgb(65, 76, 94);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    -unity-background-scale-mode: scale-to-fit;
    aspect-ratio: 1;
}

.item-config-row__name {
    flex-shrink: 0;
    min-width: 160px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(220, 230, 242);
    -unity-text-align: middle-left;
}

.item-config-row__start-container {
    margin-left: 10px;
    min-width: 300px;
}

.item-config-row__control-button {
    min-width: 86px;
    color: rgb(238, 244, 251);
    border-width: 1px;
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
    flex-grow: 1;
}

.item-config-row__collect-button {
    background-color: rgb(45, 95, 115);
    border-color: rgb(93, 155, 176);
    margin-bottom: 4px;
}

.item-config-row__collect-button:enabled:hover {
    background-color: rgb(55, 115, 138);
}

.item-config-row__remove-button {
    background-color: rgb(51, 64, 82);
    border-color: rgb(87, 102, 122);
    margin-bottom: 0;
}

.item-config-row__remove-button:enabled:hover {
    background-color: rgb(90, 45, 45);
    border-color: rgb(140, 80, 80);
}

.item-config-row__control-button:disabled {
    opacity: 0.2;
}
