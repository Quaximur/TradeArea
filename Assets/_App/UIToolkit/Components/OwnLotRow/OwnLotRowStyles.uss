.own-lot-row {
    flex-direction: row;
    align-items: stretch;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.own-lot-row__quantity-row {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.own-lot-row__inline-cell {
    flex-direction: row;
    align-items: center;
}

.own-lot-row__inline-desc {
    color: rgb(153, 166, 184);
    font-size: 14px;
    margin-right: 3px;
    -unity-text-align: lower-left;
}

.own-lot-row__inline-value {
    color: rgb(241, 245, 250);
    font-size: 16px;
    -unity-text-align: lower-left;
}

.own-lot-row__slash {
    color: rgb(100, 112, 130);
    font-size: 14px;
    margin-left: 4px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

.own-lot-row__divider {
    width: 1px;
    background-color: rgb(57, 67, 84);
    margin-left: 10px;
    margin-right: 10px;
    align-self: stretch;
}

.own-lot-row__middle {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.own-lot-row__middle-top {
    flex-direction: row;
    margin-bottom: 4px;
}

.own-lot-row__stat {
    flex-direction: row;
    justify-content: center;
    margin-right: 24px;
}

.own-lot-row__stat-desc {
    color: rgb(153, 166, 184);
    font-size: 14px;
    -unity-text-align: lower-left;
    margin-bottom: 1px;
}

.own-lot-row__stat-value {
    color: rgb(241, 245, 250);
    font-size: 16px;
    -unity-text-align: lower-left;
}

.own-lot-row__revenue-row {
    flex-direction: row;
    align-items: center;
}

.own-lot-row__revenue-formula {
    color: rgb(120, 133, 153);
    font-size: 16px;
    -unity-text-align: lower-left;
    margin-right: 5px;
}

.own-lot-row__revenue-value {
    color: rgb(138, 210, 167);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: lower-left;
}

.own-lot-row__button-group {
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    margin-left: 10px;
}

.own-lot-row__control-button {
    min-width: 86px;
    color: rgb(238, 244, 251);
    border-width: 1px;
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
    flex-grow: 1;
}

.own-lot-row__collect-button {
    background-color: rgb(45, 95, 115);
    border-color: rgb(93, 155, 176);
    margin-bottom: 4px;
}

.own-lot-row__collect-button:hover {
    background-color: rgb(55, 115, 138);
}

.own-lot-row__remove-button {
    background-color: rgb(51, 64, 82);
    border-color: rgb(87, 102, 122);
    margin-bottom: 0;
}

.own-lot-row__remove-button:hover {
    background-color: rgb(90, 45, 45);
    border-color: rgb(140, 80, 80);
}

.own-lot-row__collect-button:disabled,
.own-lot-row__remove-button:disabled {
    opacity: 0.4;
}
