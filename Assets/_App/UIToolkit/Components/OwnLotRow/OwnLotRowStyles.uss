.own-lot-row {
    flex-direction: row;
    align-items: center;
    min-height: 58px;
    background-color: rgb(32, 39, 51);
    border-color: rgb(53, 65, 82);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.own-lot-row:hover {
    background-color: rgb(40, 48, 63);
    border-left-color: rgb(233, 233, 233);
    border-right-color: rgb(233, 233, 233);
    border-top-color: rgb(233, 233, 233);
    border-bottom-color: rgb(233, 233, 233);
}

.own-lot-row__stats {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
}

.own-lot-row__stat {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    margin-right: 8px;
}

.own-lot-row__stat-desc {
    color: rgb(153, 166, 184);
    font-size: 11px;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.own-lot-row__stat-value {
    color: rgb(241, 245, 250);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.own-lot-row__stat--sold-quantity {
    min-width: 48px;
    flex-grow: 0;
}

.own-lot-row__stat--total-quantity {
    min-width: 48px;
    flex-grow: 0;
}

.own-lot-row__stat--unit-price {
    min-width: 72px;
    flex-grow: 0;
}

.own-lot-row__stat--extra-soldout-money {
    min-width: 72px;
    flex-grow: 0;
}

.own-lot-row__stat--revenue {
    flex-grow: 1;
    min-width: 160px;
}

.own-lot-row__control-button {
    height: 34px;
    min-width: 86px;
    color: rgb(238, 244, 251);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.own-lot-row__collect-button {
    background-color: rgb(45, 95, 115);
    border-color: rgb(93, 155, 176);
    margin-right: 6px;
    margin-left: 0;
}

.own-lot-row__collect-button:enabled:hover {
    background-color: rgb(55, 115, 138);
}

.own-lot-row__remove-button {
    background-color: rgb(51, 64, 82);
    border-color: rgb(87, 102, 122);
    margin-left: 0;
    margin-right: 0;
}

.own-lot-row__remove-button:enabled:hover {
    background-color: rgb(90, 45, 45);
    border-color: rgb(140, 80, 80);
}

.own-lot-row__collect-button:disabled,
.own-lot-row__remove-button:disabled {
    opacity: 0.4;
}
