<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <TradeArea.UI.Custom.LoadableListViewWidget name="LoadableListView" style="flex-grow: 1;">
        <ui:ListView name="ListView" allow-add="false" allow-remove="false" selection-type="None" show-bound-collection-size="false" fixed-item-height="72" class="auction__market-list"/>
        <ui:VisualElement name="LoadingContainer" class="auction__state-container">
            <ui:Label text="Loading..." name="LoadingLabel"/>
        </ui:VisualElement>
        <ui:VisualElement name="ErrorContainer" class="auction__state-container">
            <ui:Label text="Something went wrong." name="ErrorLabel"/>
        </ui:VisualElement>
        <ui:VisualElement name="NoItemsContainer" class="auction__state-container">
            <ui:Label text="No items found." name="NoItemsLabel"/>
        </ui:VisualElement>
    </TradeArea.UI.Custom.LoadableListViewWidget>
</ui:UXML>
