<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_App/UIToolkit/Screens/Auction/AuctionStyles.uss?fileID=7433441132597879392&amp;guid=654d3c2fc88cc6f4ea822268e7d374d5&amp;type=3#AuctionStyles"/>
    <ui:VisualElement name="AuctionWrapper" class="auction-wrapper">
        <ui:VisualElement name="AuctionPanel" class="auction-panel">
            <ui:VisualElement name="AuctionHeader" class="auction-header">
                <ui:VisualElement class="auction-title-block">
                    <ui:Label text="The Best Auction in the World" class="auction-title"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AuctionBody" class="auction-body">
                <ui:TabView name="AuctionTabView" class="auction__tab-view" style="flex-grow: 1;">
                    <ui:Tab label="Market" name="SearchTab" class="auction__tab">
                        <TradeArea.UI.AuctionSearch.AuctionSearchWidget class="auction__search-panel">
                            <ui:VisualElement name="CategoriesPanel" class="auction-panel-main" style="width: 400px; background-color: rgb(17, 21, 28); margin-right: 12px;"/>
                            <ui:VisualElement name="MarketPanel" style="flex-grow: 1;">
                                <ui:VisualElement name="SearchHeader" class="auction-market-header">
                                    <ui:Label text="ItemConfig Items For Sale" class="auction-user-title"/>
                                    <ui:Button name="RefreshMarket" text="Refresh" class="auction-button auction-button-primary" style="position: absolute; right: 0; top: 0;"/>
                                </ui:VisualElement>
                                <ui:ScrollView name="MarketList" class="auction-list auction-market-list"/>
                            </ui:VisualElement>
                        </TradeArea.UI.AuctionSearch.AuctionSearchWidget>
                    </ui:Tab>
                    <ui:Tab label="Inventory" name="InventoryTab" class="auction__tab">
                        <ui:VisualElement name="InventoryTabContent" style="flex-grow: 1; flex-direction: row;">
                            <ui:TabView name="OrdersTabView" class="auction__orders-tab-view" style="flex-grow: 1;">
                                <ui:Tab label="Sell" name="LotsTab" class="auction__orders-tab">
                                    <TradeArea.UI.AuctionLots.AuctionLotsWidget style="flex-grow: 1;">
                                        <ui:Label text="Lots" style="color: rgb(255, 255, 255);"/>
                                    </TradeArea.UI.AuctionLots.AuctionLotsWidget>
                                </ui:Tab>
                                <ui:Tab label="Buy" name="BidsTab" class="auction__orders-tab">
                                    <TradeArea.UI.AuctionBids.AuctionBidsWidget style="flex-grow: 1;">
                                        <ui:Label text="Bids" style="color: rgb(255, 255, 255);"/>
                                    </TradeArea.UI.AuctionBids.AuctionBidsWidget>
                                </ui:Tab>
                            </ui:TabView>
                            <TradeArea.UI.AuctionInventory.AuctionInventoryWidget style="flex-direction: row; flex-grow: 0;">
                                <ui:VisualElement name="InventoryPanel" class="auction-user-column auction-panel-secondary auction__inventory" style="border-left-width: 0;">
                                    <ui:VisualElement name="InventoryTitle" class="auction-user-header">
                                        <ui:Label name="User1MetaLabel" text="Inventory" class="auction-user-meta"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="CurrensyPanel" class="auction-funds-row">
                                        <ui:TextField name="User1FundsAmount" value="1000" class="auction-input auction-funds-input"/>
                                        <ui:Button name="AddMoney" text="Add Money" class="auction-button"/>
                                        <ui:Button name="RemoveMoney" text="Remove Money" class="auction-button" style="margin-left: 4px;"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="InventoryContent" class="auction-section">
                                        <ui:ScrollView name="ItemStackContainer" class="auction-inventory-list auction-panel-main"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </TradeArea.UI.AuctionInventory.AuctionInventoryWidget>
                        </ui:VisualElement>
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
