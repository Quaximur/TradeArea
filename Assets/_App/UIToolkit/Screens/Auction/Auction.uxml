<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_App/UIToolkit/Screens/Auction/AuctionStyles.uss?fileID=7433441132597879392&amp;guid=654d3c2fc88cc6f4ea822268e7d374d5&amp;type=3#AuctionStyles"/>
    <ui:VisualElement name="AuctionWrapper" class="auction-wrapper">
        <ui:VisualElement name="AuctionPanel" class="auction-panel">
            <ui:VisualElement name="AuctionHeader" class="auction-header">
                <ui:VisualElement class="auction-title-block">
                    <ui:Label text="The Best Auction in the World" class="auction-title"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AuctionBody" class="auction-body">
                <ui:TabView class="auction__tab-view" style="flex-grow: 1;">
                    <ui:Tab label="Buy" name="SearchTab" class="auction__tab">
                        <TradeArea.UI.AuctionSearch.AuctionSearchWidget class="auction__search-panel">
                            <ui:VisualElement name="CategoriesPanel" style="width: 400px; background-color: rgb(17, 21, 28); margin-right: 12px; border-left-color: rgb(49, 58, 73); border-right-color: rgb(49, 58, 73); border-top-color: rgb(49, 58, 73); border-bottom-color: rgb(49, 58, 73); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
                            <ui:VisualElement name="MarketPanel" style="flex-grow: 1;">
                                <ui:VisualElement name="SearchHeader" class="auction-market-header">
                                    <ui:Label text="ItemConfig Items For Sale" class="auction-user-title"/>
                                    <ui:Button name="RefreshMarket" text="Refresh" class="auction-button auction-button-primary" style="position: absolute; right: 0; top: 0;"/>
                                </ui:VisualElement>
                                <ui:ScrollView name="MarketList" class="auction-list auction-market-list"/>
                            </ui:VisualElement>
                        </TradeArea.UI.AuctionSearch.AuctionSearchWidget>
                    </ui:Tab>
                    <ui:Tab label="Sell" name="InventoryTab" class="auction__tab">
                        <TradeArea.UI.AuctionInventory.AuctionInventoryWidget style="flex-direction: row; flex-grow: 1;">
                            <ui:VisualElement style="flex-grow: 1;"/>
                            <ui:VisualElement class="auction-user-column">
                                <ui:VisualElement class="auction-user-header">
                                    <ui:Label name="User1MetaLabel" text="Inventory" class="auction-user-meta"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="auction-funds-row">
                                    <ui:TextField name="User1FundsAmount" value="1000" class="auction-input auction-funds-input"/>
                                    <ui:Button name="User1AddFundsButton" text="Add Funds" class="auction-button"/>
                                    <ui:Button name="User1WithdrawFundsButton" text="Withdraw" class="auction-button"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="auction-section">
                                    <ui:Label text="Inventory" class="auction-section-title"/>
                                    <ui:ScrollView name="ItemStackContainer" class="auction-list auction-inventory-list"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </TradeArea.UI.AuctionInventory.AuctionInventoryWidget>
                    </ui:Tab>
                    <ui:Tab label="Orders" name="OrdersTab" class="auction__tab">
                        <TradeArea.UI.AuctionOrders.AuctionOrdersWidget style="flex-grow: 1;"/>
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
