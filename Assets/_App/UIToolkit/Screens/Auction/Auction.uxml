<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="LoadableListView" src="project://database/Assets/_App/UIToolkit/Components/LoadableListView.uxml?fileID=9197481963319205126&amp;guid=405674e118a97084fb6d349923fc114d&amp;type=3#LoadableListView"/>
    <Style src="project://database/Assets/_App/UIToolkit/Screens/Auction/AuctionStyles.uss?fileID=7433441132597879392&amp;guid=654d3c2fc88cc6f4ea822268e7d374d5&amp;type=3#AuctionStyles"/>
    <Style src="project://database/Assets/_App/UIToolkit/Components/ItemConfigRow/ItemConfigRowStyles.uss?fileID=7433441132597879392&amp;guid=827830abc29ad854187e50730af72bfc&amp;type=3#ItemConfigRowStyles"/>
    <Style src="project://database/Assets/_App/UIToolkit/Components/OwnLotRow/OwnLotRowStyles.uss?fileID=7433441132597879392&amp;guid=d1ba5087345cc154f9fa8dbc7243ee81&amp;type=3#OwnLotRowStyles"/>
    <Style src="project://database/Assets/_App/UIToolkit/Components/OwnBidRow/OwnBidRowStyles.uss?fileID=7433441132597879392&amp;guid=236c3f1b6a8b1e44dabceb42911b59ca&amp;type=3#OwnBidRowStyles"/>
    <ui:VisualElement name="AuctionWrapper" class="auction__wrapper">
        <ui:VisualElement name="AuctionPanel" class="auction__panel">
            <ui:VisualElement name="AuctionHeader" class="auction__header">
                <ui:VisualElement class="auction__title-block">
                    <ui:Label text="The Best Auction in the World" class="auction__title"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AuctionBody" class="auction__body">
                <ui:TabView name="AuctionTabView" class="auction__tab-view" style="flex-grow: 1;">
                    <ui:Tab label="Market" name="SearchTab" class="auction__tab">
                        <TradeArea.UI.AuctionSearch.AuctionSearchWidget _loadable-list-view-widget-name="LoadableListView" class="auction__search-panel">
                            <ui:VisualElement name="CategoriesPanel" class="auction__panel-main" style="width: 400px; background-color: rgb(17, 21, 28); margin-right: 12px;"/>
                            <ui:VisualElement name="MarketPanel" style="flex-grow: 1;">
                                <ui:VisualElement name="SearchHeader" class="auction__market-header">
                                    <ui:Label text="ItemConfig Items For Sale" class="auction__user-title"/>
                                    <ui:Button name="RefreshMarket" text="Refresh" class="auction__button auction__button-primary" style="position: absolute; right: 0; top: 0;"/>
                                </ui:VisualElement>
                                <ui:Instance template="LoadableListView" name="LoadableListView" class="auction__base-list" style="flex-grow: 1;"/>
                            </ui:VisualElement>
                        </TradeArea.UI.AuctionSearch.AuctionSearchWidget>
                    </ui:Tab>
                    <ui:Tab label="Inventory" name="InventoryTab" class="auction__tab">
                        <ui:VisualElement name="InventoryRoot" class="auction__inventory-root">
                            <ui:VisualElement class="auction__orders-container">
                                <ui:TabView name="OrdersTabView" class="auction__orders-tab-view">
                                    <ui:Tab label="Buy" name="BidsTab" class="auction__orders-tab">
                                        <TradeArea.UI.AuctionBids.AuctionBidsWidget class="auction__orders-widget">
                                            <ui:VisualElement name="BidsHeader" class="auction__content-header">
                                                <ui:Label text="Active Buy Orders" name="BidsTabTitle" class="auction__content-title"/>
                                                <ui:Label text="Items you are bidding for" name="BidsDesc" class="auction__content-subtitle"/>
                                            </ui:VisualElement>
                                            <ui:Instance template="LoadableListView" name="LoadableListView" class="auction__panel-main auction__base-list" style="flex-grow: 1;">
                                                <AttributeOverrides element-name="NoItemsLabel" text="No Bids found."/>
                                            </ui:Instance>
                                        </TradeArea.UI.AuctionBids.AuctionBidsWidget>
                                    </ui:Tab>
                                    <ui:Tab label="Sell" name="LotsTab" class="auction__orders-tab">
                                        <TradeArea.UI.AuctionLots.AuctionLotsWidget class="auction__orders-widget">
                                            <ui:VisualElement name="LotsHeader" class="auction__content-header">
                                                <ui:Label text="Active Sell Orders" name="LotsTitle" class="auction__content-title"/>
                                                <ui:Label text="Items currently listed on the market" name="LotsDesc" class="auction__content-subtitle"/>
                                            </ui:VisualElement>
                                            <ui:Instance template="LoadableListView" name="LoadableListView" class="auction__panel-main" style="flex-grow: 1;">
                                                <AttributeOverrides element-name="NoItemsLabel" text="No Lots found."/>
                                            </ui:Instance>
                                        </TradeArea.UI.AuctionLots.AuctionLotsWidget>
                                    </ui:Tab>
                                </ui:TabView>
                            </ui:VisualElement>
                            <TradeArea.UI.AuctionInventory.AuctionInventoryWidget class="auction__sidebar">
                                <ui:VisualElement name="InventoryPanel" class="auction__sidebar-card">
                                    <ui:VisualElement class="auction__content-header">
                                        <ui:Label text="Inventory" class="auction__content-title"/>
                                    </ui:VisualElement>
                                    <ui:Label text="Silver" class="auction__content-subtitle"/>
                                    <ui:VisualElement class="auction__wallet-panel" style="flex-direction: row;">
                                        <ui:VisualElement class="silver-icon"/>
                                        <ui:Label text="0" name="MoneyLabel" class="auction__money-label"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="auction__inventory-stats">
                                        <ui:VisualElement class="auction__inventory-stat auction__inventory-stat-left" style="flex-grow: 2;">
                                            <ui:Label text="Weight" class="auction__inventory-stat-label"/>
                                            <ui:VisualElement class="auction__inventory-stat-value">
                                                <ui:Label text="0" name="UsedWeightLabel" class="auction__inventory-stat-number"/>
                                                <ui:Label text="/" class="auction__inventory-stat-separator"/>
                                                <ui:Label text="0" name="WeightLimitLabel" class="auction__inventory-stat-number"/>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="auction__inventory-stat">
                                            <ui:Label text="Capacity" class="auction__inventory-stat-label"/>
                                            <ui:VisualElement class="auction__inventory-stat-value">
                                                <ui:Label text="0" name="UsedCapacityLabel" class="auction__inventory-stat-number"/>
                                                <ui:Label text="/" class="auction__inventory-stat-separator"/>
                                                <ui:Label text="0" name="CapacityLimitLabel" class="auction__inventory-stat-number"/>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:Label text="Available Items" class="auction__content-subtitle"/>
                                    <ui:Instance template="LoadableListView" name="LoadableListView" class="auction__panel-main auction__base-list" style="flex-grow: 1; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px;"/>
                                </ui:VisualElement>
                            </TradeArea.UI.AuctionInventory.AuctionInventoryWidget>
                        </ui:VisualElement>
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
