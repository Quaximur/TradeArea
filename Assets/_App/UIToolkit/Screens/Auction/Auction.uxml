<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="AuctionWrapper" style="flex-grow: 1; justify-content: center; align-items: center;">
        <ui:VisualElement name="AuctionPanel" style="flex-grow: 0; justify-content: center; align-items: center; width: 1800px; height: 960px; background-color: rgb(38, 43, 55); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px;">
            <ui:Button text="Create Lot" name="CreateLot" style="border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;"/>
            <ui:Button text="Refresh Listing" name="RefreshListing" style="border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;"/>
            <ui:Button text="Refresh Own Lots" name="RefreshOwnLots" style="border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
