.auction__wrapper {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(16, 19, 26);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(49, 58, 73);
    border-right-color: rgb(49, 58, 73);
    border-top-color: rgb(49, 58, 73);
    border-bottom-color: rgb(49, 58, 73);
}

.auction__panel {
    border-color: rgb(73, 83, 100);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    width: 100%;
    height: 100%;
    max-width: 2000px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.auction__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 72px;
    margin-bottom: 12px;
}

.auction__title-block {
    flex-grow: 1;
}

.auction__title {
    color: rgb(243, 246, 251);
    font-size: 28px;
    -unity-text-align: middle-left;
}

.auction__status {
    color: rgb(174, 184, 200);
    font-size: 14px;
    margin-top: 4px;
    -unity-text-align: middle-left;
}

.auction__body {
    flex-grow: 1;
    flex-direction: row;
}

.auction__inventory {
    width: 600px;
    background-color: rgb(27, 32, 41);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    height: 100%;
}

.auction__search-panel {
    flex-grow: 1;
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    flex-direction: row;
}

.auction__user-header {
    height: 54px;
    margin-bottom: 10px;
}

.auction__market-header {
    height: auto;
    margin-bottom: 10px;
}

.auction__user-title {
    color: rgb(243, 246, 251);
    font-size: 20px;
    -unity-text-align: middle-left;
}

.auction__user-meta {
    color: rgb(153, 166, 184);
    font-size: 12px;
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.auction__funds-row {
    flex-direction: row;
    height: 36px;
    margin-bottom: 12px;
}

.auction__section {
    flex-grow: 1;
    margin-top: 6px;
}

.auction__listing-section {
    height: 250px;
    flex-grow: 0;
}

.auction__section-title {
    height: 24px;
    color: rgb(217, 224, 234);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.auction__inventory-list {
    flex-grow: 1;
}

.auction__own-lots-list {
    height: 220px;
}

.auction__market-list {
    flex-grow: 1;
}

.auction__market-list .unity-scroll-view__content-container {
    flex-grow: 1;
    height: 100%;
}

.auction__button {
    height: 34px;
    min-width: 86px;
    margin-left: 0;
    color: rgb(238, 244, 251);
    background-color: rgb(51, 64, 82);
    border-color: rgb(87, 102, 122);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.auction__button-primary {
    min-width: 132px;
    background-color: rgb(45, 95, 115);
    border-color: rgb(93, 155, 176);
}

.auction__input {
    height: 34px;
    color: rgb(242, 246, 250);
    background-color: rgb(18, 23, 32);
    border-color: rgb(65, 75, 91);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.auction__funds-input {
    width: 106px;
    color: rgb(0, 0, 0);
}

.auction__row {
    flex-direction: row;
    min-height: 58px;
    background-color: rgb(32, 39, 51);
    border-color: rgb(53, 65, 82);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-bottom: 6px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
}

.auction__icon-slot {
    width: 38px;
    height: 38px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(77, 88, 105);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-right: 8px;
}

.auction__row-main {
    flex-grow: 1;
}

.auction__row-title {
    color: rgb(241, 245, 250);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.auction__row-detail {
    color: rgb(170, 180, 195);
    font-size: 12px;
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.auction__row-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
}

.auction__small-input {
    width: 70px;
    height: 32px;
}

.auction__empty-label {
    color: rgb(127, 138, 155);
    font-size: 13px;
    margin-top: 8px;
    margin-left: 4px;
    -unity-text-align: middle-left;
}

.auction__tab {
    flex-grow: 1;
    padding-top: 12px;
}

.auction__tab .unity-tab__content-container {
    flex-grow: 1;
}

.auction__tab-view {
}

.auction__tab-view .unity-tab-view__content-viewport {
    margin-bottom: 20px;
}

.auction__tab-view .unity-tab-view__content-container {
    flex-grow: 1;
    flex-direction: column;
}

.auction__tab-view .unity-tab__header {
    width: 140px;
    height: 32px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 18px;
    justify-content: center;
}

.auction__tab-view .unity-tab__header:checked {
    -unity-font-style: bold;
}

.auction__tab-view .unity-tab__header:checked .unity-tab__header-underline {
    background-color: rgb(255, 255, 255);
}

.auction__orders-tab-view {
    flex-grow: 1;
}

.auction__orders-tab-view .unity-tab-view__header-container {
    height: 42px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.auction__orders-tab-view .unity-tab__header:checked {
    -unity-font-style: bold;
    background-color: rgb(27, 32, 41);
    color: rgb(243, 246, 251);
    border-bottom-width: 0;
}

.auction__orders-tab-view .unity-tab__header .unity-tab__header-label {
    -unity-text-align: middle-center;
}

.auction__orders-tab-view .unity-tab__header:checked .unity-tab__header-underline {
    display: none;
}

.auction__orders-tab-view .unity-tab-view__content-viewport {
    border-bottom-width: 1px;
    border-left-color: rgb(57, 67, 84);
    border-right-color: rgb(57, 67, 84);
    border-top-color: rgb(57, 67, 84);
    border-bottom-color: rgb(57, 67, 84);
    overflow: visible;
    margin-bottom: 0;
}

.auction__orders-tab-view .unity-tab-view__content-container {
    flex-grow: 1;
}

.auction__orders-tab-view .unity-tab__header {
    width: 130px;
    height: 42px;
    background-color: rgb(22, 27, 35);
    color: rgb(155, 166, 184);
    justify-content: center;
    align-items: center;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-color: rgb(57, 67, 84);
}

.auction__orders-tab {
    flex-grow: 1;
    background-color: rgb(27, 32, 41);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    border-top-width: 0;
}

.auction__inventory-root {
    flex-grow: 1;
    flex-direction: row;
}

.auction__orders-container {
    flex-grow: 1;
}

.auction__orders-widget {
    flex-grow: 1;
}

.auction__sidebar {
    width: 600px;
    margin-left: 12px;
}

.auction__sidebar-card {
    flex-grow: 1;
    background-color: rgb(27, 32, 41);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.auction__content-header {
    height: 50px;
    margin-bottom: 12px;
}

.auction__content-title {
    color: rgb(243, 246, 251);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.auction__content-subtitle {
    margin-top: 4px;
    color: rgb(153, 166, 184);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.auction__wallet-panel {
    margin-bottom: 12px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.auction__wallet-label {
    color: rgb(153, 166, 184);
    font-size: 12px;
    margin-bottom: 6px;
    -unity-text-align: lower-center;
}

.auction__inventory-stats {
    flex-direction: row;
    margin-bottom: 12px;
}

.auction__inventory-stat {
    flex-grow: 1;
    min-height: 48px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
}

.auction__inventory-stat-left {
    margin-right: 6px;
}

.auction__inventory-stat-label {
    color: rgb(153, 166, 184);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.auction__inventory-stat-value {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.auction__inventory-stat-number {
    color: rgb(243, 246, 251);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.auction__inventory-stat-separator {
    color: rgb(127, 138, 155);
    font-size: 14px;
    margin-left: 3px;
    margin-right: 3px;
    -unity-text-align: middle-center;
}

.auction__money-label {
    font-size: 24px;
    color: rgb(243, 246, 251);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.auction__wallet-input {
    margin-bottom: 8px;
}

.auction__wallet-buttons {
    flex-direction: row;
}

.auction__wallet-button-right {
    margin-left: 6px;
}

.auction__placeholder-panel {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    border-color: rgb(49, 58, 73);
    border-width: 1px;
}

.auction__placeholder-label {
    color: rgb(127, 138, 155);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.auction__panel-main {
    border-left-color: rgb(49, 58, 73);
    border-right-color: rgb(49, 58, 73);
    border-bottom-color: rgb(49, 58, 73);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgb(17, 21, 28);
    border-top-color: rgb(49, 58, 73);
}

.auction__panel-secondary {
    background-color: rgb(27, 32, 41);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(57, 67, 84);
    border-right-color: rgb(57, 67, 84);
    border-top-color: rgb(57, 67, 84);
    border-bottom-color: rgb(57, 67, 84);
}

.auction__state-container {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    color: rgb(255, 255, 255);
}

.auction__base-list {
}

.silver-icon {
    background-image: url("project://database/Assets/_App/Art/Images/Icons/silver_coin_2_512_transp.png?fileID=21300000&guid=818a8c213d0022940b35f331a0028498&type=3#silver_coin_2_512_transp");
    height: 34px;
    aspect-ratio: 1;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 6px;
}
