.auction-wrapper {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(16, 19, 26);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(49, 58, 73);
    border-right-color: rgb(49, 58, 73);
    border-top-color: rgb(49, 58, 73);
    border-bottom-color: rgb(49, 58, 73);
}

.auction-panel {
    border-color: rgb(73, 83, 100);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    width: 100%;
    height: 100%;
    max-width: 2000px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.auction-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 72px;
    margin-bottom: 12px;
}

.auction-title-block {
    flex-grow: 1;
}

.auction-title {
    color: rgb(243, 246, 251);
    font-size: 28px;
    -unity-text-align: middle-left;
}

.auction-status {
    color: rgb(174, 184, 200);
    font-size: 14px;
    margin-top: 4px;
    -unity-text-align: middle-left;
}

.auction-body {
    flex-grow: 1;
    flex-direction: row;
}

.auction__inventory {
    width: 600px;
    background-color: rgb(27, 32, 41);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    height: 100%;
}

.auction__search-panel {
    flex-grow: 1;
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    flex-direction: row;
}

.auction-user-header {
    height: 54px;
    margin-bottom: 10px;
}

.auction-market-header {
    height: auto;
    margin-bottom: 10px;
}

.auction-user-title {
    color: rgb(243, 246, 251);
    font-size: 20px;
    -unity-text-align: middle-left;
}

.auction-user-meta {
    color: rgb(153, 166, 184);
    font-size: 12px;
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.auction-funds-row {
    flex-direction: row;
    height: 36px;
    margin-bottom: 12px;
}

.auction-section {
    flex-grow: 1;
    margin-top: 6px;
}

.auction-listing-section {
    height: 250px;
    flex-grow: 0;
}

.auction-section-title {
    height: 24px;
    color: rgb(217, 224, 234);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.auction-inventory-list {
    flex-grow: 1;
}

.auction-own-lots-list {
    height: 220px;
}

.auction-market-list {
    flex-grow: 1;
}

.auction-button {
    height: 34px;
    min-width: 86px;
    margin-left: 0;
    color: rgb(238, 244, 251);
    background-color: rgb(51, 64, 82);
    border-color: rgb(87, 102, 122);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.auction-button-primary {
    min-width: 132px;
    background-color: rgb(45, 95, 115);
    border-color: rgb(93, 155, 176);
}

.auction-input {
    height: 34px;
    color: rgb(242, 246, 250);
    background-color: rgb(18, 23, 32);
    border-color: rgb(65, 75, 91);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.auction-funds-input {
    width: 106px;
    color: rgb(0, 0, 0);
}

.auction-row {
    flex-direction: row;
    min-height: 58px;
    background-color: rgb(32, 39, 51);
    border-color: rgb(53, 65, 82);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-bottom: 6px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
}

.auction-icon-slot {
    width: 38px;
    height: 38px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(77, 88, 105);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-right: 8px;
}

.auction-row-main {
    flex-grow: 1;
}

.auction-row-title {
    color: rgb(241, 245, 250);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.auction-row-detail {
    color: rgb(170, 180, 195);
    font-size: 12px;
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.auction-row-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
}

.auction-small-input {
    width: 70px;
    height: 32px;
}

.auction-empty-label {
    color: rgb(127, 138, 155);
    font-size: 13px;
    margin-top: 8px;
    margin-left: 4px;
    -unity-text-align: middle-left;
}

.auction__tab {
    flex-grow: 1;
    padding-top: 12px;
}

.auction__tab .unity-tab__content-container {
    flex-grow: 1;
}

.auction__tab-view {
}

.auction__tab-view .unity-tab-view__content-viewport {
    margin-bottom: 20px;
}

.auction__tab-view .unity-tab-view__content-container {
    flex-grow: 1;
    flex-direction: column;
}

.auction__tab-view .unity-tab__header {
    width: 140px;
    height: 32px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 18px;
    justify-content: center;
}

.auction__tab-view .unity-tab__header:checked {
    -unity-font-style: bold;
}

.auction__tab-view .unity-tab__header:checked .unity-tab__header-underline {
    background-color: rgb(255, 255, 255);
}

.auction__orders-tab-view {
    flex-direction: row;
}

.auction__orders-tab-view .unity-tab-view__header-container {
    flex-direction: column;
    height: 100%;
    justify-content: space-around;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    width: 60px;
}

.auction__orders-tab-view .unity-tab__header {
    width: 100%;
    -unity-text-align: middle-center;
    align-items: center;
    background-color: rgb(17, 21, 28);
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(57, 67, 84);
    border-right-color: rgb(57, 67, 84);
    border-top-color: rgb(57, 67, 84);
    border-bottom-color: rgb(57, 67, 84);
    flex-shrink: 1;
    flex-grow: 0;
    height: 49%;
}

.auction__orders-tab-view .unity-tab__header:checked {
    -unity-font-style: bold;
}

.auction__orders-tab-view .unity-tab__header .unity-tab__header-label {
    -unity-text-align: middle-center;
}

.auction__orders-tab-view .unity-tab__header:checked .unity-tab__header-underline {
    display: none;
}

.auction__orders-tab {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.235);
}

.auction-panel-main {
    border-left-color: rgb(49, 58, 73);
    border-right-color: rgb(49, 58, 73);
    border-top-color: rgb(49, 58, 73);
    border-bottom-color: rgb(49, 58, 73);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgb(17, 21, 28);
}

.auction-panel-secondary {
    background-color: rgb(27, 32, 41);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(57, 67, 84);
    border-right-color: rgb(57, 67, 84);
    border-top-color: rgb(57, 67, 84);
    border-bottom-color: rgb(57, 67, 84);
}

.auction-inventory-root {
    flex-grow: 1;
    flex-direction: row;
}

.auction-orders-container {
    flex-grow: 1;
}

.auction-orders-tab-view {
    flex-grow: 1;
}

.auction-orders-tab-view .unity-tab-view__header-container {
    height: 42px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.auction-orders-tab-view .unity-tab-view__content-viewport {
    border-bottom-width: 1px;
    border-left-color: rgb(57, 67, 84);
    border-right-color: rgb(57, 67, 84);
    border-top-color: rgb(57, 67, 84);
    border-bottom-color: rgb(57, 67, 84);
    overflow: visible;
    margin-bottom: 0;
}

.auction-orders-tab-view .unity-tab-view__content-container {
    flex-grow: 1;
}

.auction-orders-tab-view .unity-tab__header {
    width: 130px;
    height: 42px;
    background-color: rgb(22, 27, 35);
    color: rgb(155, 166, 184);
    justify-content: center;
    align-items: center;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-color: rgb(57, 67, 84);
}

.auction-orders-tab-view .unity-tab__header:checked {
    background-color: rgb(27, 32, 41);
    color: rgb(243, 246, 251);
    border-bottom-width: 0;
}

.auction-orders-tab-view .unity-tab__header:checked .unity-tab__header-underline {
    display: none;
}

.auction-orders-tab {
    flex-grow: 1;
    background-color: rgb(27, 32, 41);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    border-top-width: 0;
}

.auction-orders-widget {
    flex-grow: 1;
}

.auction-sidebar {
    width: 600px;
    margin-left: 12px;
}

.auction-sidebar-card {
    flex-grow: 1;
    background-color: rgb(27, 32, 41);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.auction-content-header {
    height: 50px;
    margin-bottom: 12px;
}

.auction-content-title {
    color: rgb(243, 246, 251);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.auction-content-subtitle {
    margin-top: 4px;
    color: rgb(153, 166, 184);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.auction-wallet-panel {
    margin-bottom: 12px;
    background-color: rgb(17, 21, 28);
    border-color: rgb(57, 67, 84);
    border-width: 1px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.auction-wallet-label {
    color: rgb(153, 166, 184);
    font-size: 12px;
    margin-bottom: 6px;
}

.auction-wallet-input {
    margin-bottom: 8px;
}

.auction-wallet-buttons {
    flex-direction: row;
}

.auction-wallet-button-right {
    margin-left: 6px;
}

.auction-placeholder-panel {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(17, 21, 28);
    border-color: rgb(49, 58, 73);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.auction-placeholder-label {
    color: rgb(127, 138, 155);
    font-size: 14px;
    -unity-text-align: middle-center;
}
