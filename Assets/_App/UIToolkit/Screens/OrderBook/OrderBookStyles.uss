.order-book__root {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(16, 19, 26);
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
}

.order-book__header {
    flex-direction: column;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(49, 58, 73);
}

.order-book__item-name {
    color: rgb(243, 246, 251);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.order-book__item-category {
    color: rgb(153, 166, 184);
    font-size: 12px;
    margin-top: 3px;
    -unity-text-align: middle-left;
}

.order-book__body {
    flex-direction: row;
    flex-grow: 1;
}

.order-book__book {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(17, 21, 28);
    border-width: 1px;
    border-color: rgb(49, 58, 73);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-right: 14px;
}

.order-book__book-columns {
    flex-direction: row;
    flex-grow: 1;
}

.order-book__book-panel {
    flex-grow: 1;
    flex-direction: column;
}

.order-book__book-divider {
    width: 1px;
    background-color: rgb(57, 67, 84);
    margin-left: 8px;
    margin-right: 8px;
    align-self: stretch;
}

.order-book__book-header {
    flex-direction: row;
    justify-content: space-between;
    padding-bottom: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(49, 58, 73);
}

.order-book__book-header-cell {
    color: rgb(120, 133, 153);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.order-book__book-header-cell--right {
    -unity-text-align: middle-right;
}

.order-book__book-scroll {
    flex-grow: 1;
}

.order-book__book-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 2px;
    padding-right: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 36, 47);
}

.order-book__book-row:hover {
    background-color: rgb(27, 33, 43);
}

.order-book__book-price {
    font-size: 13px;
    -unity-text-align: middle-left;
    min-width: 60px;
}

.order-book__book-price--ask {
    color: rgb(210, 100, 100);
}

.order-book__book-price--bid {
    color: rgb(100, 210, 145);
}

.order-book__book-qty {
    color: rgb(200, 210, 225);
    font-size: 13px;
    -unity-text-align: middle-right;
}

.order-book__state-label {
    color: rgb(153, 166, 184);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.order-book__state-label--error {
    color: rgb(210, 100, 100);
}

.order-book__forms {
    flex-direction: column;
    width: 220px;
    flex-shrink: 0;
    justify-content: flex-end;
}

.order-book__form {
    flex-direction: column;
    background-color: rgb(27, 32, 41);
    border-width: 1px;
    border-color: rgb(57, 67, 84);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    margin-bottom: 10px;
}

.order-book__form-title {
    color: rgb(243, 246, 251);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 10px;
}

.order-book__field-label {
    color: rgb(153, 166, 184);
    font-size: 11px;
    -unity-text-align: middle-left;
    margin-bottom: 3px;
    margin-top: 6px;
}

.order-book__input {
    height: 32px;
    color: rgb(242, 246, 250);
    background-color: rgb(18, 23, 32);
    border-width: 1px;
    border-color: rgb(65, 75, 91);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-bottom: 0;
}

.order-book__input:focus {
    border-color: rgb(93, 155, 176);
}

.order-book__total-label {
    color: rgb(220, 175, 90);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-top: 8px;
    margin-bottom: 8px;
}

.order-book__button {
    height: 34px;
    color: rgb(238, 244, 251);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.order-book__button--bid {
    background-color: rgb(35, 90, 60);
    border-color: rgb(70, 160, 105);
}

.order-book__button--bid:hover {
    background-color: rgb(45, 110, 75);
}

.order-book__button--lot {
    background-color: rgb(45, 95, 115);
    border-color: rgb(93, 155, 176);
}

.order-book__button--lot:hover {
    background-color: rgb(55, 115, 138);
}

.order-book__button:disabled {
    opacity: 0.4;
}
