<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_App/UIToolkit/Screens/OrderBook/OrderBookStyles.uss?fileID=7433441132597879392&amp;guid=69d87f026db37ec4680a17fefbe1e46a&amp;type=3#OrderBookStyles"/>
    <ui:VisualElement name="Root" class="order-book__root">
        <ui:VisualElement class="order-book__header">
            <ui:Label name="ItemName" text="—" class="order-book__item-name"/>
            <ui:Label name="ItemCategory" text="—" class="order-book__item-category"/>
        </ui:VisualElement>
        <ui:VisualElement class="order-book__body" style="width: 1300px; align-self: center; justify-content: center;">
            <ui:VisualElement class="order-book__forms">
                <ui:VisualElement name="SellPanel" class="order-book__form">
                    <ui:Label text="Place Sell Order" class="order-book__form-title"/>
                    <ui:Label text="Unit Price" class="order-book__field-label"/>
                    <ui:LongField value="1" name="SellPrice" is-delayed="true" class="order-book__input"/>
                    <ui:Label text="Quantity" class="order-book__field-label"/>
                    <ui:IntegerField value="1" name="SellQuantity" is-delayed="true" class="order-book__input"/>
                    <ui:Label name="SellTotal" text="Total: —" class="order-book__total-label"/>
                    <ui:Button name="PlaceLotButton" text="Place Lot" class="order-book__button order-book__button--lot"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="order-book__book" style="width: 1300px; flex-shrink: 0;">
                <ui:Label name="LoadingLabel" text="Loading order book…" class="order-book__state-label" style="display: none;"/>
                <ui:Label name="ErrorLabel" text="" class="order-book__state-label order-book__state-label--error" style="display: none;"/>
                <ui:VisualElement name="OrderBookContainer" style="flex-grow: 1;">
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                    <TradeArea.UI.Custom.OrderBookLine/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="order-book__forms">
                <ui:VisualElement name="BuyPanel" class="order-book__form">
                    <ui:Label text="Place Buy Order" class="order-book__form-title"/>
                    <ui:Label text="Bid Price" class="order-book__field-label"/>
                    <ui:LongField name="BuyPrice" value="1" is-delayed="true" class="order-book__input"/>
                    <ui:Label text="Quantity" class="order-book__field-label"/>
                    <ui:IntegerField value="1" name="BuyQuantity" is-delayed="true" class="order-book__input"/>
                    <ui:Label name="BuyTotal" text="Total: —" class="order-book__total-label"/>
                    <ui:Button name="PlaceBidButton" text="Place Bid" class="order-book__button order-book__button--bid"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="X" name="CloseButton" style="position: absolute; align-self: flex-end;"/>
    </ui:VisualElement>
</ui:UXML>
