.auth__root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(10, 12, 17);
    position: relative;
}

.auth__background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: none;
}

.auth__panel {
    width: 420px;
    max-width: 90%;
    padding-top: 28px;
    padding-right: 28px;
    padding-bottom: 24px;
    padding-left: 28px;
    border-width: 1px;
    border-color: rgba(125, 140, 169, 0.38);
    border-radius: 18px;
    background-color: rgba(18, 23, 31, 0.92);
    align-items: stretch;
}

.auth__header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
}

.auth__title {
    color: rgb(240, 244, 250);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.auth__subtitle {
    color: rgb(146, 159, 181);
    font-size: 13px;
    margin-top: 6px;
}

.auth__tabs {
    flex-direction: row;
    background-color: rgba(27, 34, 45, 0.9);
    border-width: 1px;
    border-color: rgba(90, 104, 125, 0.45);
    border-radius: 10px;
    padding: 4px;
    margin-bottom: 18px;
}

.auth__tab {
    flex-grow: 1;
    height: 36px;
    color: rgb(181, 197, 220);
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    margin: 0;
    -unity-font-style: bold;
}

.auth__tab:hover {
    color: rgb(240, 244, 250);
}

.auth__tab--active {
    background-color: rgb(68, 120, 214);
    color: rgb(255, 255, 255);
}

.auth__form {
    flex-direction: column;
}

.auth__error-panel {
    margin-top: 8px;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    border-width: 1px;
    border-color: rgba(212, 93, 90, 0.75);
    border-radius: 8px;
    background-color: rgba(118, 30, 32, 0.3);
}

.auth__error-label {
    color: rgb(255, 182, 182);
    font-size: 12px;
    white-space: normal;
}

.auth__input {
    min-height: 54px;
    border-radius: 10px;
    padding-top: 2px;
    padding-right: 0;
    padding-bottom: 2px;
    padding-left: 0;
    flex-direction: column;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.auth__input--secondary {
    display: none;
}

.auth__input .unity-label {
    color: rgb(178, 192, 214);
    font-size: 11px;
    margin-bottom: 4px;
}

.auth__input .unity-text-field__input {
    color: rgb(244, 247, 251);
    background-color: rgb(13, 18, 24);
    border-width: 1px;
    border-color: rgba(112, 126, 150, 0.7);
    font-size: 15px;
    height: 54px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.auth__input:focus {
    border-color: rgb(95, 155, 255);
}

.auth__primary-button,
.auth__secondary-button {
    height: 42px;
    border-radius: 10px;
    margin-top: 6px;
    -unity-font-style: bold;
    font-size: 14px;
}

.auth__primary-button {
    background-color: rgb(70, 136, 240);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.auth__primary-button:hover {
    background-color: rgb(87, 150, 245);
}

.auth__secondary-button {
    background-color: transparent;
    border-width: 1px;
    border-color: rgb(95, 112, 133);
    color: rgb(199, 210, 228);
}

.auth__secondary-button:hover {
    border-color: rgb(135, 156, 182);
    color: rgb(240, 244, 250);
}

.auth__input #unity-text-input {
    --unity-cursor-color: rgb(255, 255, 255);
}
